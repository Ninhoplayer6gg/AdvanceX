    <!-- Advance Mode -->
    <string name="advance_title">Advance Mode</string>
    <string name="advance_off_title">Original GBA</string>
    <string name="advance_off_body">The game runs exactly as on the console. No profiles, patches, replacements or shader effects.</string>
