<!-- Android 12+: back up saves and settings, never ROMs or caches. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="roms/" />
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cache/" />
        <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>
